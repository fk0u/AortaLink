# AortaLink Open-Source EHR Platform — Environment Configuration Example
# Copy this file to .env and fill in YOUR OWN credentials. Never commit real secrets.

PUBLIC_APP_NAME=AortaLink
PUBLIC_APP_VERSION=2.0.0

# MongoDB Atlas Cloud Cluster Connection (server-side only — never expose to the browser)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<cluster-name>

# JWT signing secret for the Express API (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-string

# On-device ML engine — no external AI keys are used or needed.
# AortaLink ships its own clinical analytics engine; do NOT add third-party AI keys here.
