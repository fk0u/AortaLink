{
  "name": "aortalink",
  "description": "AortaLink — open-source cardiovascular & aorta health companion (HL7 FHIR R4)",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "server": "node server/index.js",
    "client": "rsbuild dev",
    "build": "rsbuild build",
    "lint": "tsc --noEmit",
    "test:ml": "node --experimental-strip-types --no-warnings scripts/ml-selfcheck.ts",
    "test:cleanup": "node --experimental-strip-types --no-warnings scripts/cleanup-selfcheck.ts",
    "test:fhir": "node --experimental-strip-types --no-warnings scripts/fhir-selfcheck.ts",
    "test:research": "node --experimental-strip-types --no-warnings scripts/research-selfcheck.ts",
    "test:guidelines": "node --experimental-strip-types --no-warnings scripts/guideline-selfcheck.ts",
    "test:ble": "node --experimental-strip-types --no-warnings scripts/bluetooth-telemetry-selfcheck.ts",
    "test:screening": "node --experimental-strip-types --no-warnings scripts/health-screening-selfcheck.ts",
    "test:contract": "node --experimental-strip-types --no-warnings scripts/fhir-contract-selfcheck.ts",
    "test:healthscore": "node --experimental-strip-types --no-warnings scripts/health-score-selfcheck.ts",
    "test:care-routing": "node --experimental-strip-types --no-warnings scripts/care-routing-selfcheck.ts",
    "test:knowledge-base": "node --experimental-strip-types --no-warnings scripts/knowledge-base-selfcheck.ts",
    "test:satusehat": "node --experimental-strip-types --no-warnings scripts/satusehat-connector-selfcheck.ts",
    "cleanup:duplicates": "node scripts/cleanup-legacy-duplicate-readings.js",
    "preview": "rsbuild preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@rspack/core": "^2.1.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mongodb": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.7",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
